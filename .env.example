# 管理面板登录账号
APP_USERNAME=admin
APP_PASSWORD=please-change-this-password

# 用于加密 OpenList 密码和签名登录 Cookie，必须换成随机长字符串
APP_SECRET=please-change-this-to-a-long-random-secret

# 面板对外端口
PORT=8080

# 数据库目录。Docker 部署时不要修改
DATA_DIR=/app/data

# 默认禁止图片来源访问内网地址；如果你的 API 在局域网，改成 true
ALLOW_PRIVATE_URLS=false

# 单张 API 响应/图片的大小限制（MB）
MAX_DOWNLOAD_MB=30

# 单次 HTTP 请求超时（秒）
REQUEST_TIMEOUT_SECONDS=45
